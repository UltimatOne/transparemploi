				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse la réponse JSON\r",
									"let data = pm.response.json();\r",
									"\r",
									"// Met à jour les variables de collection\r",
									"if (data.token) {\r",
									"    pm.collectionVariables.set(\"token\", data.token);\r",
									"    console.log(\"✅ Token mis à jour :\", data.token);\r",
									"}\r",
									"\r",
									"if (data.refreshToken) {\r",
									"    pm.collectionVariables.set(\"refreshToken\", data.refreshToken);\r",
									"    console.log(\"✅ Refresh token mis à jour :\", data.refreshToken);\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
